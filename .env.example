# Copy this file to `.env.local` and fill in values from your Supabase project.
# Next.js only exposes variables that start with NEXT_PUBLIC_ to the browser.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Do not prefix with NEXT_PUBLIC_ — the AI route uses this key.
GEMINI_API_KEY=your-gemini-api-key

# Enable Email auth in the Supabase dashboard (Authentication → Providers).
# New recon_sessions rows store auth.users.id in user_id.
